# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two

START get_item

    SET current_room = player's current room
    SET room_item = item located in current_room
    SET inventory = player's current inventory

    OUTPUT "Enter the item you want to get:"
    INPUT requested_item

    IF requested_item = room_item THEN

        ADD requested_item TO inventory
        OUTPUT requested_item + " added to your inventory."

        REMOVE requested_item FROM current_room

    ELSE

        OUTPUT "That item is not in this room."

    END IF

    RETURN to game loop

END get_item
