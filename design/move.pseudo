# Assignment: IT 140 Project One Move-Between-Rooms Pseudocode
# Date: October 5, 2026
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7

START move_between_rooms

    SET current_room = player's current room

    WHILE game is not over

        OUTPUT "Enter a direction: north, south, east, or west"
        INPUT direction

        IF direction is a valid exit from current_room THEN

            SET current_room = room connected in that direction
            OUTPUT "You moved to " + current_room

        ELSE

            OUTPUT "You cannot go that way."

        END IF

    END WHILE

END move_between_rooms
